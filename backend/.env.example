# Copy to backend/.env and fill in. Never commit .env.

# LLM access goes through OpenRouter, pinned to Google's own infrastructure.
OPENROUTER_API_KEY=
# Model id on OpenRouter. Default: fast and cheap, supports tool calling.
GEMINI_MODEL=google/gemini-3.7-flash
# "openrouter" for the real model, "fake" for the offline rule-based agent (tests, demos).
HAIL_LLM=openrouter

# SQLite now; a postgresql+psycopg:// URL later.
DATABASE_URL=sqlite:///./hail.db

# Seconds a confirmation token stays valid after the recommendation is shown.
CONFIRMATION_TTL_SECONDS=90
# Max CHECK_FARES actions per user per rolling hour.
FARE_CHECKS_PER_HOUR=30
