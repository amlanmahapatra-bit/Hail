<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Hail icon: "Speak to Hail" opens straight into listening. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="speak"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/shortcut_speak"
        android:shortcutLongLabel="@string/shortcut_speak_long">
        <intent
            android:action="app.hail.VOICE"
            android:targetPackage="app.hail.android"
            android:targetClass="app.hail.android.MainActivity" />
    </shortcut>
</shortcuts>
